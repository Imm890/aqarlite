# ───────────── قاعدة البيانات ─────────────
# اتصال التطبيق وقت التشغيل: مستخدم محدود الصلاحيات (ليس superuser وليس مالك الجداول)
# حتى تُطبَّق سياسات Row Level Security فعلياً.
DATABASE_URL=postgres://aqarlite_app:change-me-app-password@127.0.0.1:5432/aqarlite
# اتصال المسؤول: للـ migrations والـ seed فقط (لا يستخدمه التطبيق أبداً)
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/aqarlite
# كلمة مرور مستخدم التطبيق؛ يضبطها سكربت db:migrate على الدور aqarlite_app
APP_DB_PASSWORD=change-me-app-password

# ───────────── التطبيق ─────────────
# العنوان العام الأساسي (يُستخدم للتحقق من ترويسة Origin ضد CSRF)
APP_URL=http://localhost:3000
# عدد وسطاء الـ reverse proxy الموثوقين أمام التطبيق (لقراءة IP الحقيقي من X-Forwarded-For).
# 0 = لا وسيط (لا يُوثق بالترويسة). خلف nginx/Cloudflare واحد اجعلها 1.
TRUST_PROXY_HOPS=0
# مدة الجلسة المطلقة بالساعات، ومهلة الخمول بالدقائق
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# للتطوير على http فقط (يُتجاهل في production حيث الكوكي دائماً Secure)
# COOKIE_SECURE=false

# ───────────── بيانات seed التجريبية ─────────────
# كلمة مرور الحسابات التجريبية (تُخزَّن مُجزّأة بـ Argon2id). إن تُركت فارغة تُولَّد عشوائياً وتُطبع مرة واحدة.
SEED_PASSWORD=Demo-Passw0rd-2026!
